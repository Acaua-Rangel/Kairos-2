#!/usr/bin/env python
"""Launcher for the `hbot` CLI.

The installed entry point is the `hbot` console script in .venv/bin (declared under
[project.scripts] in pyproject.toml). This file stays as a direct launcher for running the
CLI straight out of the checkout: `env python` picks up whichever environment is active, and
importing path_util puts the repo root on sys.path.
"""
import sys

import path_util  # noqa: F401  (puts the repo root ahead of bin/ on sys.path)

from hummingbot.cli.main import main

if __name__ == "__main__":
    sys.exit(main())
