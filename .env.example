# Binance API credentials, used for both the `binance` (spot) and `binance_perpetual` (perp
# futures) connectors. Not needed for `binance_paper_trade` (paper trading simulates fills
# against live market data, no account access required).
#
# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit real keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
