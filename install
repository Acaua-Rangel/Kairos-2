#!/bin/bash
#
# Thin wrapper around `make install`, kept for muscle memory and for the CI action.
# The real install lives in the Makefile: Poetry resolves the locked dependency set into
# ./.venv, then an editable install compiles the Cython extensions and exposes `hbot`.

cd "$(dirname "$0")" || exit 1

DYDX=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dydx)
            DYDX=1
            echo "Including the dydx_v4 dependency group."
            shift
            ;;
        *)
            # Ignore unrecognized parameters, as the previous conda-based script did.
            shift
            ;;
    esac
done

exec make install DYDX=$DYDX
